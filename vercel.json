{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,.cache/**,db.sqlite3,data/sources/osm_*.json,data/sources/geonames/**,data/sources/gha_ADM1.geojson,data/sources/*_simple.geojson}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
